# Dataflow worker image with crdb2spanner and all its dependencies pre-installed.
#
# Use it when Dataflow workers cannot reach PyPI (no external IPs and no Cloud NAT): without it,
# workers pip-install the package's dependencies at startup. PY and BEAM_VERSION must match the
# Python and Apache Beam versions of the machine that submits the jobs.
#
# Build and push with scripts/build_worker_image.sh, then submit with
#   C2S_WORKER_IMAGE=<image> crdb2spanner load|replicate ... -- --runner DataflowRunner ...
ARG PY=3.12
ARG BEAM_VERSION=2.78.0
FROM apache/beam_python${PY}_sdk:${BEAM_VERSION}
ARG BEAM_VERSION

WORKDIR /opt/crdb2spanner
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
# keep the image's Beam version: the workers' SDK must match the submitter's
RUN pip install --no-cache-dir . "apache-beam[gcp]==${BEAM_VERSION}" \
 && python -c "import crdb2spanner, apache_beam; print('crdb2spanner on Beam', apache_beam.__version__)"
